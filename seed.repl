# seed.repl — Example: Small retail shop
# Place alongside docker-compose.yml to pre-configure the MVP site on first boot.

# Company
create Company with company_name: My Shop, country: India, default_currency: INR

# Warehouses
create Warehouse with warehouse_name: Store Room, company: My Shop
create Warehouse with warehouse_name: Shop Floor, company: My Shop

# Item Groups
create Item Group with item_group_name: Finished Goods, parent_item_group: All Item Groups
create Item Group with item_group_name: Consumables, parent_item_group: All Item Groups

# Items
create Item with item_name: Notebook A4, item_group: Finished Goods, stock_uom: Nos
create Item with item_name: Pen (Blue), item_group: Finished Goods, stock_uom: Nos
create Item with item_name: Printer Paper Ream, item_group: Consumables, stock_uom: Nos

# Customers
create Customer with customer_name: Walk-in Customer, customer_group: Individual, territory: India
create Customer with customer_name: ABC School, customer_group: Commercial, territory: India

# Suppliers
create Supplier with supplier_name: Navneet Distributors, supplier_group: Raw Material
create Supplier with supplier_name: Local Wholesale, supplier_group: Raw Material
