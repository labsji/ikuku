# ikuku white-label config
# Customize these values to brand the installer for your company.
# Then run: build-installer.ps1 to generate your branded exe.

# Your company
COMPANY_NAME=Acme Solutions
CONTACT_NAME=John Smith
CONTACT_EMAIL=john@acme.com
CONTACT_PHONE=+1-555-0100
WEBSITE=https://acme.com

# Installer branding
INSTALLER_TITLE=ERPNext by Acme Solutions
INSTALLER_TAGLINE=Enterprise Resource Planning — evaluate on your own machine
EXE_NAME=acme-erpnext

# Default apps to pre-select (comma-separated: wiki,lms,erpnext,crm)
DEFAULT_APPS=wiki,erpnext

# Logo: place your logo as logo.ico (256x256) in this folder
# LOGO=logo.ico
