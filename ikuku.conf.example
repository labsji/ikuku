# ikuku.conf — per-prospect eval kit config
# Baked by evalKit.sh alongside the exe for headless activation.
#
# ACTIVATION_CODE is a one-time OTP generated by the reseller's coordinator.
# On first boot, init.sh registers with the auth proxy using this code.
# After registration, the code is consumed and cannot be reused.

# Kiro activation (required for AI agent)
ACTIVATION_CODE=

# Prospect info (used by seed.repl loader)
PROSPECT_NAME=
INDUSTRY=
COUNTRY=India

# Install ID (for tracking — defaults to hostname if empty)
INSTALL_ID=
