# Caddyfile - Reverse proxy for Frappe bench
# At deploy time, init-sqlite.sh replaces {{SITE_ADDRESS}} with the actual
# domain name (enabling automatic HTTPS via Let's Encrypt) or :80 for IP access.

{{SITE_ADDRESS}} {
    # Frappe web application
    reverse_proxy localhost:8000

    # Frappe socketio (realtime updates)
    @websockets {
        path /socket.io/*
    }
    reverse_proxy @websockets localhost:9000

    # Encode responses
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}
